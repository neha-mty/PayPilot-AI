# Database (default: SQLite, change to PostgreSQL URL when ready)
# SQLite (default - zero setup):
DATABASE_URL=sqlite+aiosqlite:///./paypilot.db
# PostgreSQL (when ready):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paypilot

# JWT Secret - CHANGE THIS in production
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Google Gemini API (get from https://aistudio.google.com/apikey)
# Leave empty to use mock AI assistant
GEMINI_API_KEY=

# Payment Provider: "simulated" (default) or "razorpay"
PAYMENT_PROVIDER=simulated

# Razorpay Sandbox (optional - only needed if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Simulated Payment Provider
SIMULATED_WEBHOOK_SECRET=sim-webhook-secret-for-testing

# App Settings
APPROVAL_EXPIRY_MINUTES=15
DEFAULT_CURRENCY=INR
